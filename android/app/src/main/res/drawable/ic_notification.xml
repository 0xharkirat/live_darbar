<?xml version="1.0" encoding="utf-8"?>
<!--
    The small icon in the status bar and on the notification.

    Android paints it as a silhouette, so only the shape counts and the colour
    is ignored. The launcher icon has a coloured background and thin outlines,
    which turn into a solid white square when they are used this way. So the
    mark here is the Darbar Sahib as 1 filled shape: the central dome and the 2
    side cupolas, each with its finial, on a wall with an open door.

    The door winds the other way from the rest, so the default fill cuts it
    out. test/tool/notification_icon_test.dart checks the shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The wall with its open door, and the ledge along its top. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,11 H20 V21 H4 Z M2,10 H22 V12 H2 Z M10,16 V21 H14 V16 A2,2 0 0 0 10,16 Z" />
    <!-- The central dome and its finial. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.5,10 V8.8 C8.5,6.6 9.8,5.4 12,4.2 C14.2,5.4 15.5,6.6 15.5,8.8 V10 Z M11.25,5 V2 H12.75 V5 Z" />
    <!-- The 2 side cupolas and their finials. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,10 V7 A2,2 0 0 1 7,7 V10 Z M4.25,5.5 V3 H5.75 V5.5 Z M17,10 V7 A2,2 0 0 1 21,7 V10 Z M18.25,5.5 V3 H19.75 V5.5 Z" />
</vector>
