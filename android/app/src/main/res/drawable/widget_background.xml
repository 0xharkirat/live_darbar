<?xml version="1.0" encoding="utf-8"?>
<!-- The canvas with a hairline edge, as the cards in the app have. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_canvas" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
