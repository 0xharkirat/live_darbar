<?xml version="1.0" encoding="utf-8"?>
<!--
    The Live Kirtan button. There is one gold button per widget.

    It is 40 dp of capsule inside a 48 dp target, so the inset takes 4 dp off
    the top and the bottom. It has its own ripple, dark on the gold, because
    a light ripple on gold is not visible. The ripple starts on touch-down, in
    the launcher, and is the first answer the listener gets. The drawable is
    the background of the view that takes the tap, so the ripple and the
    capsule are the same shape. widget_button_gold_loading.xml is the same
    capsule dimmed, for a source that is opening.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#400C0A09">
    <item>
        <inset
            android:insetBottom="4dp"
            android:insetTop="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_gold" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset
            android:insetBottom="4dp"
            android:insetTop="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
</ripple>
