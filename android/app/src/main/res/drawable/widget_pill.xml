<?xml version="1.0" encoding="utf-8"?>
<!--
    The Hukamnama button: a raised surface with a hairline edge, as the app's
    secondary controls have. It is the same 40 dp capsule as the gold Live
    Kirtan button, inside a 48 dp target, so the inset takes 4 dp off the top
    and the bottom.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="4dp"
    android:insetTop="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/widget_surface_high" />
        <stroke
            android:width="1dp"
            android:color="@color/widget_border" />
        <corners android:radius="20dp" />
    </shape>
</inset>
