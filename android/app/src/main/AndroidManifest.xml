<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        Required from Android 13 (API 33). Without it the media transport
        notification never reaches the notification drawer, which is the only
        way to control playback once the app is in the background.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        The daily Hukamnama reminder is a repeating alarm, and a reboot clears
        alarms. This lets flutter_local_notifications hear that the phone has
        started, and set the reminder again. It is not an exact-alarm
        permission: the reminder is inexact on purpose, so it needs none.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        enableOnBackInvokedCallback: the system asks the app first whether it
        will handle back, and the app says yes while a sheet or a page is open.
        Android 16 makes this so for every app that targets it, this one
        included. Turning it on here gives Android 13 to 15 the same path, and
        shows the phone's home screen under the app when back leaves it. Some
        phones (Xiaomi, from a report on flutterpro.design) do not close a
        sheet on back without it. The app has no WillPopScope, which the flag
        breaks. test/widgets/android_back_test.dart holds both ways of sending
        back.
    -->
    <application
        android:label="Live Darbar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="custom.actions.intent.PLAY_LIVE_DARBAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- OACP foreground actions -->
            <intent-filter>
                <action android:name="${applicationId}.oacp.ACTION_PLAY_LIVE_KIRTAN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="${applicationId}.oacp.ACTION_PLAY_MUKHWAK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="${applicationId}.oacp.ACTION_PLAY_KATHA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="${applicationId}.oacp.ACTION_VIEW_MUKHWAK_PDF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The daily Hukamnama reminder, from flutter_local_notifications.
            The first receiver shows the notification when its alarm fires.
            The second sets the alarm again after a reboot and after the app
            updates, because both clear it. Neither is exported: the system
            reaches them through the PendingIntent and the boot broadcast.
        -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- OACP background receiver (for future background actions) -->
        <receiver
            android:name=".oacp.OacpActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.oacp.ACTION_PLACEHOLDER" />
            </intent-filter>
        </receiver>
        <!--
            The home screen widget. Only the system's widget host sends the
            update broadcast, and the receiver does no more than draw from the
            store Flutter wrote, so exporting it gives other apps nothing. The
            two taps on the widget that open a screen reach MainActivity by
            explicit intent, so they need no filter above.
        -->
        <receiver
            android:name=".widget.LiveDarbarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/live_darbar_widget_info" />
        </receiver>

        <!--
            The widget's two controls, the gold button and Listen. The launcher
            sends the widget's own PendingIntents here when the user taps one,
            and the receiver sends the command on to the media session. It is
            not exported: nothing but the widget can reach it, so another app
            cannot start playback through it. Each PendingIntent carries one of
            four fixed actions (Command in WidgetPlayback.kt), and no extra on
            the intent is read.
        -->
        <receiver
            android:name=".widget.WidgetControlReceiver"
            android:exported="false" />

        <!--
            The media session, and the one thing in this file that Android Auto
            and voice assistants talk to. audio_service's service is a
            MediaBrowserService: it answers a browse request with the three
            items that LiveDarbarAudioHandler lists, and passes "play" and
            "play from search" on to Dart. The intent filter is how they find
            it, and exported must stay true for the same reason.
        -->
        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true" tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Headset, Bluetooth and notification buttons. -->
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true" tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            The paintings for the browse rows in Android Auto. A file in the
            app's private directory is unreadable to the Auto host, so a small
            provider serves the three paintings and nothing else. It is
            exported for that reason, it opens files for reading only, and it
            answers only /0.jpg, /1.jpg and /2.jpg. The authority is the one
            lib/src/core/artwork_store.dart builds its URIs from.
        -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            Tells Android Auto this is a media app. The file names the kind
            of app; the browse tree itself comes from the service above.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>